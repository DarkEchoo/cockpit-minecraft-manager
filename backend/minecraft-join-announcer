#!/usr/bin/env python3
"""Monitor a single systemd Minecraft unit and broadcast custom join/leave messages over local RCON."""
import json
import logging
import re
import signal
import socket
import struct
import subprocess
import sys
import time
from pathlib import Path

CONFIG = Path('/etc/minecraft-join-announcer.json')
STOP = False
JOIN = re.compile(r'(?:System chat:\s*)?(?P<name>[A-Za-z0-9_]{3,16}) joined the game\s*$')
LEAVE = re.compile(r'(?:System chat:\s*)?(?P<name>[A-Za-z0-9_]{3,16}) left the game\s*$')

def stopping(*_):
    global STOP
    STOP = True

def read_props(path):
    props = {}
    for line in Path(path).read_text().splitlines():
        s = line.strip()
        if s and not s.startswith(('#','!')) and '=' in s:
            k, v = s.split('=', 1)
            props[k.strip()] = v.strip()
    return props

def recv_exact(sock, size):
    result = bytearray()
    while len(result) < size:
        chunk = sock.recv(size - len(result))
        if not chunk:
            raise ConnectionError('RCON connection closed')
        result.extend(chunk)
    return bytes(result)

def recv_packet(sock):
    length = struct.unpack('<i', recv_exact(sock, 4))[0]
    if not 10 <= length <= 4096:
        raise ValueError('Invalid RCON packet size')
    data = recv_exact(sock, length)
    return struct.unpack('<ii', data[:8]) + (data[8:-2],)

def send_packet(sock, request_id, kind, payload):
    body = struct.pack('<ii', request_id, kind) + payload.encode('utf-8') + b'\x00\x00'
    sock.sendall(struct.pack('<i', len(body)) + body)

def announce(cfg, message):
    props = read_props(cfg['properties'])
    if props.get('enable-rcon', '').lower() != 'true':
        raise RuntimeError('RCON disabled in server.properties')
    pwd = props.get('rcon.password', '')
    if not pwd:
        raise RuntimeError('RCON password missing in server.properties')
    port = int(props.get('rcon.port', '25575'))
    # For safety the service never connects to a remote RCON address.
    with socket.create_connection(('127.0.0.1', port), timeout=3) as s:
        s.settimeout(3)
        send_packet(s, 101, 3, pwd)
        response = recv_packet(s)
        if response[0] == -1:
            raise RuntimeError('RCON authentication rejected')
        if response[0] != 101:
            # Some servers send an empty auth response before the actual result.
            response = recv_packet(s)
        if response[0] != 101:
            raise RuntimeError('Unexpected RCON authentication response')
        # json.dumps provides a JSON text component with proper escaping.
        cmd = 'tellraw @a ' + json.dumps({'text': message, 'color': cfg.get('color', 'gold')}, ensure_ascii=False)
        send_packet(s, 102, 2, cmd)
        recv_packet(s)

def run(cfg):
    unit = cfg['unit']
    if not re.fullmatch(r'[A-Za-z0-9_.@-]+\.service', unit):
        raise ValueError('Invalid service unit')
    recent = {}
    while not STOP:
        # --since now avoids old events replaying after a restart.
        cmd = ['journalctl', '--no-pager', '-f', '-n', '0', '-o', 'cat', '-u', unit]
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True, bufsize=1)
        try:
            for line in p.stdout:
                if STOP:
                    break
                match = JOIN.search(line.rstrip()) or LEAVE.search(line.rstrip())
                if not match:
                    continue
                name = match.group('name')
                action = 'join' if JOIN.search(line.rstrip()) else 'leave'
                now = time.monotonic()
                key = (name, action)
                if now - recent.get(key, -9999) < 3:
                    continue
                recent[key] = now
                template = cfg.get(action + '_message', '✦ {player} joined!' if action == 'join' else '✦ {player} left!')
                message = template.replace('{player}', name)
                try:
                    announce(cfg, message)
                    logging.info('%s: %s', action, name)
                except Exception as exc:
                    logging.warning('Unable to broadcast %s for %s: %s', action, name, exc)
            if not STOP:
                logging.warning('Journal follower stopped; restarting')
        finally:
            p.terminate()
            try:
                p.wait(timeout=3)
            except subprocess.TimeoutExpired:
                p.kill()
        if not STOP:
            time.sleep(2)

if __name__ == '__main__':
    logging.basicConfig(level=logging.INFO, format='%(asctime)s %(levelname)s %(message)s')
    signal.signal(signal.SIGTERM, stopping)
    signal.signal(signal.SIGINT, stopping)
    try:
        run(json.loads(CONFIG.read_text()))
    except Exception as e:
        logging.error('Announcer failed: %s', e)
        sys.exit(1)
