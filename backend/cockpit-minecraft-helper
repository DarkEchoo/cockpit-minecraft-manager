          'Stop the server and take a verified backup before editing world or startup files.'
        ]}

def resource_plan(server_id,min_gib,max_gib,cores):
    # Validate a proposed plan only; do not persist or execute it.
    if not (min_gib.isdigit() and max_gib.isdigit() and cores.isdigit()):
        raise ValueError('RAM and core values must be whole numbers')
    mn,mx,cp=map(int,(min_gib,max_gib,cores))
    if not (1<=mn<=mx<=64 and 1<=cp<=32):
        raise ValueError('Require 1 <= minimum RAM <= maximum RAM <= 64 GiB, and 1-32 logical CPUs')
    total_kib=0
    try:
        for line in pathlib.Path('/proc/meminfo').read_text().splitlines():
            if line.startswith('MemTotal:'):
                total_kib=int(line.split()[1]);break
    except OSError:pass
    total_gib=round(total_kib/1048576,2) if total_kib else None
    warnings=[]
    if total_gib and mx>total_gib*0.7:warnings.append('Maximum heap exceeds 70% of total physical RAM; leave headroom for OS, native JVM memory and other services.')
    if cp<4:warnings.append('Restricting CPU time may worsen tick lag; this is a proposed quota, not CPU affinity.')
    return {'server':server_id,'minimum_heap':'-Xms'+str(mn)+'G',
            'maximum_heap':'-Xmx'+str(mx)+'G','proposed_cpu_quota':str(cp*100)+'%',
            'physical_ram_gib':total_gib,'warnings':warnings,
            'status':'Preview only. No file, systemd unit, JVM flag or server was changed.',
            'next_step':'Confirm the server launcher and existing heap flags before implementing persistent changes.'}


# v6: scoped, reversible configuration management for the existing NeoForge instance.
def v6_heap_path():
    unit=run(['systemctl','show','minecraft-26.service','--property=WorkingDirectory','--value'],check=False).strip()
    root=pathlib.Path(unit) if unit.startswith('/') else MINECRAFT
    if root.resolve()!=MINECRAFT.resolve():
        raise ValueError('Unexpected NeoForge working directory; refusing to edit JVM settings')
    path=root/'user_jvm_args.txt'
    if not path.is_file() or path.is_symlink():raise ValueError('NeoForge JVM argument file missing or symbolic link')
    return path

def v6_heap_read():
    path=v6_heap_path();content=path.read_text()
    pairs=re.findall(r'(?m)^\s*-Xm([sx])\s*(\d+)([gGmM])(?=\s|$)',content)
    values={}
    for kind,num,unit in pairs:
        if kind in values:raise ValueError('Duplicate JVM heap setting; manual review required')
        values[kind]=int(num) if unit.lower()=='g' else int(num)/1024
    if set(values)!={'s','x'}:raise ValueError('Expected one -Xms and one -Xmx setting')
    return {'minimum_gib':values['s'],'maximum_gib':values['x'],'file':str(path),'server_state':state('minecraft-26.service')}

def v6_heap_save(minimum,maximum):
    from decimal import Decimal,InvalidOperation
    try:
        mn=Decimal(minimum);mx=Decimal(maximum)
    except InvalidOperation:raise ValueError('Heap values must be whole GiB')
    if mn!=int(mn) or mx!=int(mx) or not 1<=mn<=mx<=24:raise ValueError('Choose whole GiB values: 1 <= minimum <= maximum <= 24')
    if state('minecraft-26.service')!='inactive':raise ValueError('Stop NeoForge before editing JVM heap')
    path=v6_heap_path();old=path.read_text();v6_heap_read()
    total=0
    for line in pathlib.Path('/proc/meminfo').read_text().splitlines():
        if line.startswith('MemTotal:'):total=int(line.split()[1])/1048576;break
    if not total or float(mx)>total*0.7:raise ValueError('Maximum heap must be at most 70% of physical RAM')
    new,n1=re.subn(r'(?m)^(\s*-Xms)\s*\d+[gGmM](?=\s|$)',lambda m:m.group(1)+str(int(mn))+'G',old)
    new,n2=re.subn(r'(?m)^(\s*-Xmx)\s*\d+[gGmM](?=\s|$)',lambda m:m.group(1)+str(int(mx))+'G',new)
    if n1!=1 or n2!=1:raise ValueError('Cannot safely identify heap flags')
    import tempfile
    backup_dir=pathlib.Path('/var/backups/cockpit-minecraft-manager/v6-jvm');backup_dir.mkdir(parents=True,exist_ok=True)
    stamp=time.strftime('%Y%m%dT%H%M%SZ',time.gmtime())+'-'+str(time.time_ns())
    backup=backup_dir/('user_jvm_args-'+stamp+'.txt')
    shutil.copy2(path,backup)
    fd,tmp=tempfile.mkstemp(prefix='.jvm-v6-',dir=path.parent)
    try:
        os.fchmod(fd,path.stat().st_mode & 0o777)
        with os.fdopen(fd,'w') as f:
            f.write(new);f.flush();os.fsync(f.fileno())
        os.chown(tmp,path.stat().st_uid,path.stat().st_gid)
        if state('minecraft-26.service')!='inactive':raise ValueError('Server started during edit; no changes applied')
        os.replace(tmp,path)
    finally:
        if os.path.exists(tmp):os.unlink(tmp)
    return {'saved':True,'minimum_gib':int(mn),'maximum_gib':int(mx),'backup':str(backup),'note':'Settings apply on next server start; server was not started'}

def v6_recovery_read():
    unit='minecraft-26.service'
    fields=['Restart','RestartUSec','StartLimitBurst','StartLimitIntervalUSec']
    values={}
    for field in fields:
        values[field]=run(['systemctl','show',unit,'--property='+field,'--value'],check=False)
    return {'unit':unit,'settings':values,'state':state(unit),'note':'Read-only. Existing on-failure policy is unchanged.'}

def v6_recovery_save(delay,burst,interval):
    if state('minecraft-26.service')!='inactive':raise ValueError('Stop NeoForge before editing crash recovery')
    try:d=int(delay);b=int(burst);i=int(interval)
    except ValueError:raise ValueError('Use integer recovery settings')
    if str(d)!=delay or str(b)!=burst or str(i)!=interval or not (5<=d<=300 and 1<=b<=10 and 60<=i<=3600):
        raise ValueError('Delay 5-300 seconds; burst 1-10; interval 60-3600 seconds')
    directory=pathlib.Path('/etc/systemd/system/minecraft-26.service.d')
    target=directory/'90-cockpit-v6-recovery.conf'
    backup_dir=pathlib.Path('/var/backups/cockpit-minecraft-manager/v6-recovery');backup_dir.mkdir(parents=True,exist_ok=True)
    directory.mkdir(parents=True,exist_ok=True)
    backup=None
    if target.exists():
        backup=backup_dir/('recovery-'+str(time.time_ns())+'.conf');shutil.copy2(target,backup)
    content='[Unit]\nStartLimitIntervalSec='+str(i)+'\nStartLimitBurst='+str(b)+'\n\n[Service]\nRestart=on-failure\nRestartSec='+str(d)+'\n'
    import tempfile
    fd,tmp=tempfile.mkstemp(prefix='.recovery-v6-',dir=directory)
    try:
        with os.fdopen(fd,'w') as f:f.write(content);f.flush();os.fsync(f.fileno())
        os.chmod(tmp,0o644)
        if state('minecraft-26.service')!='inactive':raise ValueError('Server started during edit; no changes applied')
        os.replace(tmp,target)
        try:run(['systemctl','daemon-reload'],timeout=30)
        except Exception:
            if backup:shutil.copy2(backup,target)
            else:target.unlink(missing_ok=True)
            run(['systemctl','daemon-reload'],timeout=30,check=False)
            raise
    finally:
        if os.path.exists(tmp):os.unlink(tmp)
    return {'saved':True,'file':str(target),'previous_override_backup':str(backup) if backup else None,'note':'No server start or restart was performed'}


# v7: bounded read-only performance history. The collector runs independently via systemd timer.
def v7_metrics(server_id, hours):
    import sqlite3
    unit=service_name(server_id)
    if hours not in ('1','6','24','168'):raise ValueError('Unsupported history window')
    db=pathlib.Path('/var/lib/cockpit-minecraft-metrics/history.sqlite3')
    if not db.exists():return {'samples':[],'retention_days':7,'interval_seconds':60,'message':'No samples yet. Check the collector timer.'}
    con=sqlite3.connect('file:'+str(db)+'?mode=ro',uri=True,timeout=5)
    try:
        rows=con.execute('SELECT ts,active,memory_bytes,cpu_usec FROM samples WHERE unit=? AND ts>=? ORDER BY ts',(unit,int(time.time())-int(hours)*3600)).fetchall()
    finally:con.close()
    # Downsample server-side to at most ~420 points; compute CPU using original adjacent samples.
    out=[];previous=None
    for ts,active,mem,cpu in rows:
        percent=None
        if previous and active and previous[1] and cpu is not None and previous[2] is not None and ts>previous[0] and cpu>=previous[2]:
            percent=round((cpu-previous[2])/(ts-previous[0])/10000,2)
        previous=(ts,active,cpu)
        out.append({'ts':ts,'active':bool(active),'memory_gib':round(mem/1073741824,3) if mem is not None else None,'cpu_percent':percent})
    stride=max(1,(len(out)+419)//420)
    return {'samples':out[::stride] if stride==1 else out[::stride]+([out[-1]] if out[-1] is not out[::stride][-1] else []),'retention_days':7,'interval_seconds':60,'cpu_note':'100% equals one logical CPU; usage can exceed 100%','message':None}

# Read-only player activity feed. Never triggers RCON connections.
_ACTIVITY_RULES = (
    ('join', re.compile(r'\b(?:joined the game|logged in with entity id)\b', re.I)),
    ('leave', re.compile(r'\b(?:left the game|lost connection|disconnected:|timed out)\b', re.I)),
    ('chat', re.compile(r'(?:\b(?:Async Chat Thread|Chat Thread)\b|\[Server thread/INFO\].*?: <[^>]+>|\bchat: <[^>]+>)', re.I)),
    ('announcement', re.compile(r'\b(?:System chat:|advancement|completed the challenge|reached the goal|made the advancement|was slain|was blown up|fell from|drowned|burned to death|hit the ground too hard|was shot by|was killed by|issued server command:|\[Not Secure\])\b', re.I)),
    ('command', re.compile(r'\b(?:issued server command:|issued command:|executed command:|ran command:|issued server command)\b', re.I)),
    ('moderation', re.compile(r'\b(?:kicked|banned|unbanned|whitelist|made .* a server operator|opped|de-opped)\b', re.I)),
)

def player_activity(server_id):
    unit = service_name(server_id)  # validated server ID; never arbitrary journal units
    raw = run(['journalctl','-u',unit,'--since','24 hours ago','-n','2500',
               '--no-pager','--output=short-iso'],timeout=20,check=False)
    events=[]
    for line in raw.splitlines():
        # Skip non-Minecraft infrastructure messages, including RCON socket noise.
        if not ('java[' in line or 'minecraft[' in line):
            continue
        if re.search(r'RCON|User Authenticator',line,re.I):
            continue
        kind=None
        for category,pattern in _ACTIVITY_RULES:
            if pattern.search(line):
                kind=category
                break
        if kind:
            events.append({'type':kind,'text':line[:1800]})
    return {'events':events[-500:],'scope':'Last 24 hours (up to 2,500 recent journal lines). Some events may be unavailable after log rotation.',
            'note':'Only events recorded by the Minecraft server can appear here. Vanilla does not reliably log every player command.'}

def schedule_bridge(action, server_id, payload=None):
    # Scheduler has a separate root-only on-disk state and its own timer.
    service_name(server_id)  # validate against the existing manager registry
    cmd=['/usr/local/libexec/cockpit-minecraft-announcements',action,server_id]
    result=subprocess.run(cmd,input=payload,text=True,capture_output=True,timeout=18)
    if result.returncode:
        raise RuntimeError((result.stderr or result.stdout).strip()[:800])
    return json.loads(result.stdout)

def main(args):
    if not args:raise ValueError('Missing operation')
    op,*a=args
    if op=='v7-metrics' and len(a)==2:return v7_metrics(*a)
    if op=='v6-heap-read' and len(a)==0:return v6_heap_read()
    if op=='v6-heap-save' and len(a)==2:return v6_heap_save(*a)
    if op=='v6-recovery-read' and len(a)==0:return v6_recovery_read()
    if op=='v6-recovery-save' and len(a)==3:return v6_recovery_save(*a)
    if op=='create-with-backup' and len(a)==9:return create_with_backup(*a)
    if op=='backup-settings' and len(a)==1:return backup_settings_for(a[0])
    if op=='backup-settings-save' and len(a)==5:return save_backup_settings(*a)
    if op=='restore-export' and len(a)==2:return export_restore_snapshot(*a)
    if op=='branding-icon-status' and len(a)==1:return branding_icon_status(a[0])
    if op=='branding-icon-upload' and len(a)==1:return branding_icon_upload(a[0])
    if op=='settings' and len(a)==1:return properties_dict(a[0])
    if op=='settings-save' and len(a)==1:
        raw=sys.stdin.buffer.read(16000)
        return save_settings(a[0],json.loads(raw.decode('utf-8')))
    if op=='announce' and len(a)==2:return broadcast_announcement(a[0],a[1])
    if op=='schedule-read' and len(a)==1:
        return schedule_bridge('read',a[0])
    if op=='schedule-save' and len(a)==1:
        raw=sys.stdin.buffer.read(8192)
        if len(raw)>8191:raise ValueError('Schedule too large')
        return schedule_bridge('save',a[0],raw.decode('utf-8'))
    if op=='schedule-test' and len(a)==1:
        return schedule_bridge('test',a[0])
    if op=='schedule-history' and len(a)==1:
        return schedule_bridge('history',a[0])

    if op=='players' and len(a) in (2,3):return player_action(a[0],a[1],a[2] if len(a)==3 else None)
    if op=='stats' and len(a)==1:return stats_server(a[0])
    if op=='insights' and len(a)==1:return server_insights(a[0])
    if op=='history' and len(a)==1:return operational_history(a[0])
    if op=='control-center' and len(a)==1:return control_center(a[0])
    if op=='resource-plan' and len(a)==4:return resource_plan(*a)
    if op=='resource-policy' and len(a)==1:return resource_policy(a[0])
    if op=='cpu-quota' and len(a)==2:return apply_cpu_quota(a[0],a[1])
    if op=='addons' and len(a)==1:return addon_catalog(a[0])
    if op=='addon-toggle' and len(a)==3:return toggle_addon(a[0],a[1],a[2]=='enable')
    if op=='snapshots-json' and len(a)==1:return snapshot_objects(a[0])
    if op=='restore' and len(a)==3:return restore_snapshot(a[0],a[1],a[2])
    if op=='files' and len(a)==1:return file_catalog(a[0])
    if op=='file-read' and len(a)==2:return read_config(a[0],a[1])
    if op=='file-save' and len(a)==2:
        raw=sys.stdin.buffer.read(1024*1024+1)
        if len(raw)>1024*1024:raise ValueError('Config content too large')
        return save_config(a[0],a[1],raw.decode('utf-8'))
    if op=='file-upload' and len(a)==3:return upload_file(a[0],a[1],a[2])
    if op=='list' and len(a)==0:
        return [{**info(i),'state':state(service_name(i)),'rcon':rcon_ready(i)} for i in ['neoforge',*sorted(registry())]]
    if op=='player-activity' and len(a)==1:return player_activity(a[0])
    if op=='logs' and len(a)==1:
        unit=service_name(a[0]);return run(['journalctl','-u',unit,'-n','80','--no-pager','--output=short-iso'],timeout=15,check=False)
    if op=='service' and len(a)==2:
        id,action=a
        if action not in ('start','stop','restart'):raise ValueError('Invalid action')
        unit=service_name(id)
        if action in ('start','restart') and id!='neoforge' and registry()[id].get('type')=='spigot' and not (managed_path(id)/'build-success').exists():raise ValueError('Spigot build is not ready; check build status')
        if action in ('start','restart'):
            # Starting any server in Cockpit automatically stops the other instances.
            # Restart an already running server without interfering with others only after
            # exclusive ownership is established.
            result=switch_server(id)
            if action=='restart' and id not in result['stopped']:
                run(['systemctl','restart',unit],timeout=180)
            return {'state':state(unit),'stopped':result['stopped']}
        run(['systemctl','stop',unit],timeout=180)
        return {'state':state(unit)}
    if op=='command' and len(a)==2:return rcon_command(a[0],a[1])
    if op=='enable-rcon' and len(a)==1:return enable_rcon(a[0])
    if op=='switch' and len(a)==1:return switch_server(a[0])
    if op=='backup' and len(a) in (0,1):return backup_selected(a[0] if a else 'neoforge')
    if op=='snapshots' and len(a) in (0,1):return snapshots_selected(a[0] if a else 'neoforge')
    if op=='versions' and len(a)==0:return minecraft_versions()
    if op=='upgrade-vanilla' and len(a)==2:return upgrade_vanilla(a[0],a[1])
    if op=='create' and len(a) in (4,5):return do_create(a[0],a[1],a[2],a[3],a[4] if len(a)==5 else '')
    if op=='relocate' and len(a)==2:return relocate_server(a[0],a[1])
    if op=='build-status' and len(a)==1:return build_status(a[0])
    raise ValueError('Unknown operation or invalid arguments')

if __name__=='__main__':
    try:
        if sys.argv[1:2]==['build-spigot'] and len(sys.argv)==3:
