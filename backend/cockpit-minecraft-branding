#!/usr/bin/env python3
"""Cockpit-only friendly labels; server IDs and on-disk paths never change."""
import json,os,pathlib,re,sys,tempfile,subprocess,fcntl
DB=pathlib.Path('/etc/cockpit-minecraft/branding.json')
REG=pathlib.Path('/etc/cockpit-minecraft/servers.json')
BASE_IDS={'neoforge'}
def ids():
    d=json.loads(REG.read_text()) if REG.exists() else {}
    return BASE_IDS|set(d)
def main():
    if os.geteuid()!=0:raise PermissionError('Administrative privileges required')
    if len(sys.argv)!=3 or sys.argv[1] not in ('read','save'):raise ValueError('Invalid request')
    operation,server=sys.argv[1:]
    if server not in ids() or not re.fullmatch(r'[a-z][a-z0-9-]{1,34}',server):raise ValueError('Unknown server')
    DB.parent.mkdir(mode=0o755,parents=True,exist_ok=True)
    with (DB.parent/'.branding.lock').open('a+') as lock:
        fcntl.flock(lock.fileno(),fcntl.LOCK_EX)
        data=json.loads(DB.read_text()) if DB.exists() else {}
        if operation=='read':return {'label':data.get(server,'')}
        raw=sys.stdin.read(4097)
        if len(raw)>4096:raise ValueError('Request too large')
        form=json.loads(raw)
        label=form.get('label','')
        if not isinstance(label,str) or len(label)>56 or any(ord(c)<32 or ord(c)==127 for c in label):raise ValueError('Invalid name')
        data[server]=label.strip()
        fd,tmp=tempfile.mkstemp(prefix='.branding-',dir=DB.parent)
        try:
            os.fchmod(fd,0o600)
            with os.fdopen(fd,'w') as f:json.dump(data,f);f.flush();os.fsync(f.fileno())
            os.replace(tmp,DB)
        finally:
            if os.path.exists(tmp):os.unlink(tmp)
        return {'label':data[server]}
if __name__=='__main__':
 try:print(json.dumps({'ok':True,'data':main()}))
 except Exception as exc:print(json.dumps({'ok':False,'error':str(exc)[:200]}))
