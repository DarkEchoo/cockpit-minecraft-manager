#!/usr/bin/env python3
"""TCP proxy to a configured Minecraft server on loopback only."""
import json, signal, socket, socketserver, threading, select
from pathlib import Path

CONFIG = Path("/etc/minecraft-default-port.json")
STOP = threading.Event()

class Handler(socketserver.BaseRequestHandler):
    def handle(self):
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as upstream:
            try:
                upstream.settimeout(10)
                upstream.connect(("127.0.0.1", self.server.target_port))
                self.request.settimeout(0.5)
                upstream.settimeout(0.5)
                sockets = (self.request, upstream)
                while not STOP.is_set():
                    ready, _, _ = select.select(sockets, [], [], 1)
                    for source in ready:
                        try:
                            data = source.recv(65536)
                        except socket.timeout:
                            continue
                        if not data:
                            return
                        destination = upstream if source is self.request else self.request
                        destination.sendall(data)
            except OSError:
                pass

class Server(socketserver.ThreadingMixIn, socketserver.TCPServer):
    daemon_threads = True
    allow_reuse_address = True
    request_queue_size = 128
    def __init__(self, address, handler, target_port):
        self.target_port = target_port
        super().__init__(address, handler)

def main():
    config = json.loads(CONFIG.read_text())
    target = config.get("port")
    if type(target) is not int or not 1 <= target <= 65535 or target == 25565:
        raise SystemExit("Invalid backend port")
    with Server(("0.0.0.0", 25565), Handler, target) as server:
        def stop(*_):
            STOP.set()
            threading.Thread(target=server.shutdown, daemon=True).start()
        signal.signal(signal.SIGTERM, stop)
        signal.signal(signal.SIGINT, stop)
        server.serve_forever(poll_interval=0.2)

if __name__ == "__main__":
    main()
