#!/usr/bin/env python3
"""Limited Minecraft Java TCP forwarder. No Minecraft protocol parsing; preserves bytes."""
import json, os, signal, socket, socketserver, threading
from pathlib import Path
CONFIG=Path('/etc/minecraft-default-port.json')
STOP=threading.Event()
class Handler(socketserver.BaseRequestHandler):
    def handle(self):
        with socket.socket(socket.AF_INET,socket.SOCK_STREAM) as upstream:
            try:
                upstream.settimeout(10)
                upstream.connect(('127.0.0.1',self.server.target_port))
                upstream.settimeout(None)
                self.request.settimeout(0.5)
                upstream.settimeout(0.5)
                socks=(self.request,upstream)
                while not STOP.is_set():
                    import select
                    ready,_,_=select.select(socks,[],[],1)
                    for sock in ready:
                        try: data=sock.recv(65536)
                        except socket.timeout: continue
                        if not data:return
                        dest=upstream if sock is self.request else self.request
                        dest.sendall(data)
            except (OSError, ConnectionError):pass
class Server(socketserver.ThreadingMixIn,socketserver.TCPServer):
    daemon_threads=True
    allow_reuse_address=True
    request_queue_size=128
    def __init__(self,addr,handler,target_port):
        self.target_port=target_port
        super().__init__(addr,handler)
def main():
    d=json.loads(CONFIG.read_text())
    p=d.get('port')
    if type(p) is not int or p<1 or p>65535 or p==25565:raise SystemExit('Invalid backend port')
    with Server(('0.0.0.0',25565),Handler,p) as server:
        def stop(*_):STOP.set();threading.Thread(target=server.shutdown,daemon=True).start()
        signal.signal(signal.SIGTERM,stop)
        signal.signal(signal.SIGINT,stop)
        print(f'Minecraft default TCP port 25565 -> 127.0.0.1:{p}',flush=True)
        server.serve_forever(poll_interval=.2)
if __name__=='__main__':main()
