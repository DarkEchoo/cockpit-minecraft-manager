#!/usr/bin/env python3
"""v1.0 isolated stopped-workspace scheduled snapshots; never controls Minecraft services."""
import json,os,pathlib,re,subprocess,sys,fcntl,hashlib
import sys as _sys;_sys.path.insert(0,'/usr/local/libexec')
from mc_backup_config import load as _load_config, mount_check as _mount_check
_CFG=_load_config()

UUID=_CFG['filesystem_uuid']
DEST=pathlib.Path(_CFG['backup_directory'])
ENGINE='/usr/local/libexec/cockpit-minecraft-backup'
NAME=re.compile(r'^[a-z][a-z0-9-]{1,34}$')

def run(args,timeout=15):
 return subprocess.run(args,text=True,capture_output=True,timeout=timeout,check=False)
def error(msg):raise RuntimeError(msg)
def preflight(name):
 if not NAME.fullmatch(name):error('Invalid workspace name')
 for p in [DEST, pathlib.Path(ENGINE)]:
  if p.is_symlink() or not p.exists():error('Required path missing or symlink: '+str(p))
 if not DEST.is_dir():error('Backup destination is not a directory')
 _mount_check(_CFG)
 if os.stat(DEST).st_dev==os.stat(_CFG['workspace_root']).st_dev:error('Destination on source filesystem')
 unit='mc-managed-'+name+'.service'
 x=run(['systemctl','show',unit,'-p','LoadState','--value'])
 y=run(['systemctl','is-active',unit])
 if x.returncode or x.stdout.strip()!='loaded' or y.stdout.strip()!='inactive':
  error('Service must be loaded and inactive (not failed/unknown/active): '+unit)
 return {'workspace':name,'unit':unit,'backup_destination':str(DEST),'filesystem_uuid':UUID,'service_state':'inactive'}
def main():
 if len(sys.argv)!=3 or sys.argv[1] not in ('check','run'):error('Usage: cockpit-mc-snapshot check|run workspace-id')
 op,name=sys.argv[1:]
 result=preflight(name)
 if op=='check': result['changes_made']=False
 else:
  # Each workspace has an exclusive lock; other jobs can still use the legacy Restic path.
  lock='/run/lock/cockpit-mc-snapshot-'+name+'.lock'
  with open(lock,'a+') as handle:
   try:fcntl.flock(handle,fcntl.LOCK_EX|fcntl.LOCK_NB)
   except BlockingIOError:error('Backup already in progress')
   result=preflight(name)
   p=run([ENGINE,'backup',name,str(DEST)],timeout=1800)
   if p.returncode:error('Archive creation failed: '+p.stdout[-1200:]+p.stderr[-500:])
   try:obj=json.loads(p.stdout)
   except ValueError:error('Backup engine did not return JSON')
   if not obj.get('ok'):error('Backup engine reported failure')
   archive=obj['data']['archive']
   if pathlib.Path(archive).parent!=DEST:error('Unexpected archive destination')
   v=run([ENGINE,'verify',archive],timeout=1800)
   if v.returncode:error('Checksum verification failed: '+v.stdout[-1200:])
   result.update({'archive':archive,'sha256':obj['data']['sha256'],'checksum_verified':True,'changes_made':True})
 print(json.dumps({'ok':True,'data':result},indent=2))
if __name__=='__main__':
 try:main()
 except Exception as exc:
  print(json.dumps({'ok':False,'error':str(exc)}));sys.exit(1)
