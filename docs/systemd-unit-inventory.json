      "policy": "preserve on upgrade; optional host setup for fresh install"
    },
    {
      "unit": "minecraft-resource-queue.service",
      "required_executable": "cockpit-minecraft-resource-queue",
      "packaged_executable": true,
      "policy": "preserve on upgrade; optional host setup for fresh install"
    },
    {
      "unit": "minecraft-resource-queue.timer",
      "required_executable": null,
      "packaged_executable": true,
      "policy": "preserve on upgrade; optional host setup for fresh install"
    }
  ]
